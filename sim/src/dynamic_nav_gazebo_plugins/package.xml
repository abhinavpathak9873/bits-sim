<?xml version="1.0"?>
<package format="3">
  <name>dynamic_nav_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>Gazebo Classic plugins for smooth scripted dynamic navigation actors.</description>
  <maintainer email="research@example.com">Dynamic Nav Research Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>gazebo_dev</build_depend>
  <exec_depend>gazebo_dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
